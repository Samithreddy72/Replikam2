[Unit]
Description=Refresh the in-camera idle/status frame so its ticks stay live
# Without this the card was rendered exactly once at boot: a bridge that lost
# Wi-Fi kept showing "✓ Wi-Fi" to the meeting laptop forever. The renderer skips
# the write when nothing changed, so this is cheap.

[Timer]
OnBootSec=45s
OnUnitActiveSec=20s
AccuracySec=5s
Unit=bridge-idle-frame.service

[Install]
WantedBy=timers.target
