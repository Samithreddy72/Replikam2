[Unit]
Description=NetBridge uvc-gadget daemon
After=bridge-gadget.service
Wants=bridge-gadget.service
# RATE-LIMIT restarts (do NOT use infinite restarts here). If uvcd crashes (e.g. a corrupt
# libuvcgadget.so, or /dev/video40 not ready) it restarts every RestartSec; with a USB host
# attached, that rapid gadget churn hangs the dwc2 driver -> the 15s hardware watchdog hard-
# resets the Pi -> unclean reset corrupts files -> uvcd crashes again = reboot spiral.
# Capping the burst makes uvcd give up (visible "failed") instead of spiralling the whole Pi.
StartLimitIntervalSec=120
StartLimitBurst=5
[Service]
ExecStart=/usr/local/bin/bridge-run.sh bridge-uvcd.sh
Restart=always
RestartSec=5
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGKILL
[Install]
WantedBy=multi-user.target
