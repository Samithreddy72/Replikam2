[Unit]
Description=NetBridge audio receiver (RTP Opus -> UAC2 mic)
After=bridge-gadget.service
Wants=bridge-gadget.service
StartLimitIntervalSec=120
StartLimitBurst=3
[Service]
# Cache lives on writable /var/cache; read-only /root cannot retain plugin scans.
CacheDirectory=netbridge/gstreamer-1.0
Environment=GST_REGISTRY=/var/cache/netbridge/gstreamer-1.0/registry.bin
ExecStartPre=/usr/local/bin/bridge-wait.sh uac2
ExecStart=/usr/local/bin/bridge-run.sh bridge-feeder-audio.sh
Restart=always
TimeoutStopSec=5
KillMode=mixed
RestartSec=5
[Install]
WantedBy=multi-user.target
