#!/bin/sh
# The device's setup-AP passphrase — the one printed on the label (walkthrough J1 step 3).
#
# POLICY (Samith, 2026-07-25): a FIXED "bridge2626" for EVERY bridge, until he changes it
# deliberately. This deliberately overrides build-ledger E1's random-per-device key for
# testing convenience — one password that works on any card without a lookup. To restore
# per-device randomness later, revert this file to the random generator (git history).
#
# Trade-off he has accepted: a shared, known setup password means someone in radio range
# during the brief setup window could join the AP and capture the venue Wi-Fi as it is
# typed. Fine for test/dev; reconsider before production.
#
# Enforcing (not just create-if-absent): if the persisted file holds anything other than
# the fixed value — empty, or a stale random key from a card provisioned before this policy —
# it is rewritten to the fixed value, so a wiped /data or an old card self-heals to bridge2626.
# Stored mode 600 under /etc/bridge, a bind from /data, so it is stable for the installation.
set -u
PASS_FILE=/etc/bridge/setup-wifi-pass
FIXED=bridge2626

if [ -s "$PASS_FILE" ] && [ "$(cat "$PASS_FILE")" = "$FIXED" ]; then
  cat "$PASS_FILE"
  exit 0
fi

if install -d -m 755 /etc/bridge 2>/dev/null &&
   (umask 077; printf '%s' "$FIXED" > "$PASS_FILE" 2>/dev/null); then
  chmod 600 "$PASS_FILE" 2>/dev/null || true
  cat "$PASS_FILE"
else
  # /etc/bridge unwritable (is /data mounted?). Emit the value so the AP still comes up.
  printf '%s' "$FIXED"
fi
