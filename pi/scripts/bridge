#!/bin/bash
# NetBridge control CLI
SERVICES="bridge-gadget bridge-feeder-net bridge-uvcd bridge-feeder-audio bridge-return-audio"
MEDIA="bridge-feeder-net bridge-feeder-audio bridge-return-audio bridge-uvcd"
DEF=/etc/default/bridge-return-audio
ok(){ printf '  \033[32m%-22s %s\033[0m\n' "$1" "$2"; }
bad(){ printf '  \033[31m%-22s %s\033[0m\n' "$1" "$2"; }
line(){ printf '  %-22s %s\n' "$1" "$2"; }

cmd_status(){
  echo "=== NetBridge status @ $(hostname) ($(hostname -I | awk '{print $1}')) ==="
  echo "Services:"
  for s in $SERVICES; do
    st=$(systemctl is-active "$s")
    if [ "$st" = active ]; then ok "$s" "$st"; else bad "$s" "$st"; fi
  done
  echo "USB gadget:"
  local udc=$(cat /sys/class/udc/*/state 2>/dev/null)
  local spd=$(cat /sys/class/udc/*/current_speed 2>/dev/null)
  if [ "$udc" = configured ]; then ok "host" "$udc ($spd)"; else line "host" "$udc  (no client attached)"; fi
  line "functions" "$(ls /sys/kernel/config/usb_gadget/g1/functions/ 2>/dev/null | tr '\n' ' ')"
  echo "Devices:"
  [ -e /dev/video40 ] && ok "loopback" "/dev/video40" || bad "loopback" "missing"
  [ -d /proc/asound/UAC2Gadget ] && ok "UAC2 audio card" "present" || bad "UAC2 audio card" "missing"
  echo "Config:"
  [ -f "$DEF" ] && . "$DEF"
  line "return peer" "${RETURN_DEST_IP:-?}:${RETURN_DEST_PORT:-?}  (speaker-return target)"
  [ -f /etc/default/bridge-net ] && . /etc/default/bridge-net
  line "net profile" "video=${NET_VIDEO_LATENCY:-100}ms audio=${NET_AUDIO_LATENCY:-120}ms jitterbuffer"
  echo "Tailscale:"
  if command -v tailscale >/dev/null 2>&1; then
    local ts4=$(tailscale ip -4 2>/dev/null | head -1)
    local bes=$(tailscale status --json 2>/dev/null | grep -m1 '"BackendState"' | cut -d'"' -f4)
    [ -n "$ts4" ] && ok "ip4" "$ts4" || bad "ip4" "none"
    line "backend" "${bes:-unknown}"
    if [ -n "${RETURN_DEST_IP:-}" ]; then
      # A successful ping is far more trustworthy than tcpdump on the Pi, which lies
      # about udpsink egress (see CLAUDE.md).
      if ping -c1 -W1 "$RETURN_DEST_IP" >/dev/null 2>&1; then ok "peer reach" "$RETURN_DEST_IP ok"; else bad "peer reach" "$RETURN_DEST_IP unreachable"; fi
    fi
  else
    bad "tailscale" "not installed"
  fi
  echo "Health:"
  line "temp/throttle" "$(vcgencmd measure_temp 2>/dev/null | cut -d= -f2)  $(vcgencmd get_throttled 2>/dev/null)"
  local sig=$(awk 'NR>2{gsub(/\./,"",$4); print $4}' /proc/net/wireless 2>/dev/null)
  [ -n "$sig" ] && line "wifi signal" "${sig} dBm"
  line "uptime" "$(uptime -p 2>/dev/null | sed 's/up //')"
  # Report these separately. They used to share one line reading
  # "watchdog timer=active hw=0", where "active" referred to the SOFTWARE
  # self-heal timer — so the line looked healthy while the HARDWARE watchdog was
  # switched off. That is how a disabled watchdog hid for two weeks, until a hang
  # needed a physical replug to recover.
  local hwstate=$(cat /sys/class/watchdog/watchdog0/state 2>/dev/null)
  local hwsec=$(systemctl show -p RuntimeWatchdogUSec --value)
  # NOT red when off: it is off DELIBERATELY (commit f370860 — arming it at 15s
  # caused a boot-with-client-attached reboot spiral). Stating the trade-off beats
  # both a scary red line and the old line that hid it entirely.
  if [ "$hwstate" = active ]; then
    ok   "watchdog (hardware)" "armed, ${hwsec} — a hang self-recovers"
  else
    line "watchdog (hardware)" "off by design (boot-with-client spiral) — a hang needs a replug"
  fi
  line "self-heal timer" "$(systemctl is-active bridge-watchdog.timer)  (restarts dead services every 30s)"
}

restart_media(){
  # The uvc-gadget is the CONSUMER of /dev/video40; bridge-feeder-net is the PRODUCER.
  # If the producer is restarted while the consumer still holds the loopback, v4l2 caps
  # negotiation fails ("not-negotiated") and the gadget starves (EAGAIN flood -> no/jittery
  # video). So always: stop the consumer, (re)start the producers, let feeder-net renegotiate
  # the format as sole owner, THEN reattach the consumer.
  sudo systemctl stop bridge-uvcd
  sudo systemctl restart bridge-feeder-net bridge-feeder-audio bridge-return-audio
  sleep 3
  sudo systemctl start bridge-uvcd
}

case "$1" in
  status|"" ) cmd_status ;;
  start )   echo "Starting all services..."; sudo systemctl start $SERVICES; sleep 2; cmd_status ;;
  stop )    echo "Stopping media services (USB device stays enumerated)..."; sudo systemctl stop $MEDIA ;;
  restart ) echo "Restarting media (safe - does NOT touch the USB gadget)..."; restart_media; sleep 1; cmd_status ;;
  restart-all )
    echo "WARNING: this rebuilds the USB gadget - the client may need a replug."
    read -p "Continue? [y/N] " a; [ "$a" = y ] || { echo aborted; exit 0; }
    sudo systemctl restart bridge-gadget; sleep 3; sudo systemctl restart $MEDIA; sleep 2; cmd_status ;;
  reset-clock )
    # Rebuilds the gadget to reset a degraded UAC2 audio clock - the fix for
    # return-audio that has gone noisy/crackly. No reboot. The client's
    # camera/mic/speaker drop and re-enumerate, so re-select them on the client.
    echo "Resetting UAC2 audio clock (rebuilding gadget; no reboot)..."
    echo "NOTE: the client's UVC Camera / Microphone / Speakers will briefly drop - re-select them there."
    sudo systemctl restart bridge-gadget; sleep 3
    sudo systemctl restart $MEDIA; sleep 2
    echo "Clock reset done."
    cmd_status ;;
  heal )    echo "Running self-heal watchdog once..."; sudo /usr/local/bin/bridge-watchdog.sh; echo done; cmd_status ;;
  set-peer )
    [ -z "$2" ] && { echo "usage: bridge set-peer <ip> [port]"; exit 1; }
    P="${3:-5004}"
    printf '# speaker-return destination (the remote peer)\nRETURN_DEST_IP=%s\nRETURN_DEST_PORT=%s\n' "$2" "$P" | sudo tee "$DEF" >/dev/null
    echo "return peer set to $2:$P; restarting return-audio..."
    sudo systemctl restart bridge-return-audio; sleep 1
    line "return peer" "$2:$P" ;;
  return-tune )
    # Runtime pipeline experiments for the followed-rate clicks: writes the SEPARATE tune
    # file (set-peer wholesale-rewrites bridge-return-audio, so knobs cannot live there)
    # and restarts the service. Charset is allow-listed because these values are
    # word-split into a gst-launch command line: letters/digits = _ . - ! and space only.
    #   bridge return-tune "<src props>" "<pre-resample elems>"
    #   bridge return-tune clear
    TUNE=/etc/default/bridge-return-tune
    if [ "$2" = "clear" ]; then
      sudo rm -f "$TUNE"
      echo "return-tune cleared; restarting return-audio..."
      sudo systemctl restart bridge-return-audio; sleep 1
      line "return tune" "(defaults)"; exit 0
    fi
    case "$2$3" in *[!a-zA-Z0-9=_.!\ -]* )
      echo "return-tune: illegal characters (allowed: letters digits = _ . - ! space)"; exit 1 ;;
    esac
    { printf '# pipeline experiment knobs (bridge return-tune) - safe to delete\n'
      [ -n "$2" ] && printf 'RETURN_SRC_PROPS="%s"\n' "$2"
      [ -n "$3" ] && printf 'RETURN_PRE_RESAMPLE="%s"\n' "$3"
    } | sudo tee "$TUNE" >/dev/null
    echo "return-tune set; restarting return-audio..."
    sudo systemctl restart bridge-return-audio; sleep 1
    line "src props" "${2:-—}"; line "pre-resample" "${3:-—}" ;;
  profile )
    # Switch the rtpjitterbuffer latency profile. Restarts ONLY the two feeders
    # (safe - does not touch the USB gadget).
    case "$2" in
      lan ) V=200; A=200 ;;
      wan ) V=300; A=300 ;;
      * ) echo "usage: bridge profile <lan|wan>"; exit 1 ;;
    esac
    printf '# NetBridge media tuning (bridge profile %s)\nNET_VIDEO_LATENCY=%s\nNET_AUDIO_LATENCY=%s\n' "$2" "$V" "$A" | sudo tee /etc/default/bridge-net >/dev/null
    echo "net profile '$2' (video=${V}ms audio=${A}ms); restarting media..."
    restart_media; sleep 1; cmd_status ;;
  setup-pass )
    # What goes on the printed setup label (walkthrough J1 step 3 / J2 step 2).
    # Derived per device from the CPU serial via bridge-derive-pass, so it is STABLE:
    # a reflash or a lost /data no longer changes it, and a label already stuck on the
    # box keeps working. An admin can pin a custom one by writing the file; that wins.
    PF=/etc/bridge/setup-wifi-pass
    PC=$(curl -s --max-time 2 http://localhost:8080/api/status 2>/dev/null \
         | grep -o '"pairing_code": *"[^"]*"' | cut -d'"' -f4)
    echo "=== NetBridge setup label ==="
    line "Wi-Fi"    "BridgeSetup-${PC:-Pi}"
    line "password" "$(sudo cat "$PF")"
    line "pairing"  "${PC:-unknown}" ;;
  logs )
    svc="${2:-bridge-uvcd}"; case "$svc" in bridge-*) :;; *) svc="bridge-$svc";; esac
    echo "=== last 40 log lines of $svc (Ctrl-C to exit follow) ==="
    journalctl -u "$svc" -n 40 --no-pager; echo "--- following (Ctrl-C to stop) ---"; journalctl -u "$svc" -f ;;
  help|-h|--help )
    cat <<H
bridge - NetBridge control
  bridge status            show health (services, USB, devices, peer, wifi, temp)
  bridge start             start all services
  bridge stop              stop media feeders (USB device stays connected)
  bridge restart           restart media feeders (SAFE - won't drop the USB device)
  bridge restart-all       rebuild everything incl USB gadget (asks; client may replug)
  bridge reset-clock       rebuild gadget to reset a degraded UAC2 audio clock (fixes noisy return audio; client re-selects devices)
  bridge heal              run the self-heal watchdog once
  bridge set-peer <ip> [port]   set speaker-return destination (default port 5004)
  bridge return-tune "<props>" ["<pre>"]  pipeline experiment knobs (clear: bridge return-tune clear)
  bridge profile <lan|wan> set jitterbuffer latency profile (lan=100/120, wan=200/200ms)
  bridge setup-pass        print the setup-label details (AP name, random password, pairing code)
  bridge logs [service]    tail+follow logs (e.g. bridge logs feeder-net)
  bridge help              this help
H
    ;;
  * ) echo "unknown command '$1' - try: bridge help"; exit 1 ;;
esac
