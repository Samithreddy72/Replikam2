# Copy to .env (or export) before running. NEVER commit real secrets.
DATABASE_URL=postgresql+psycopg://bridge:bridge@localhost/bridge
# Comma-separated bootstrap tokens accepted at device enrollment. Rotate regularly.
# `token` enrolls devices into org 'default'; `token:acme` enrolls into org 'acme' (multi-tenant).
BOOTSTRAP_TOKENS=change-me-bootstrap-1,change-me-acme-token:acme
# Admin API key the panel uses to call /admin/*.
ADMIN_API_KEY=change-me-admin-key
OFFLINE_AFTER_S=60
TEMP_ALERT_C=75
# An open alert clears only below these, not the moment it dips under its limit (hysteresis):
TEMP_CLEAR_C=72
USB_MISS_ALERT_PER_S=15
USB_MISS_CLEAR_PER_S=12
DISK_LOW_MB=500

# ── Alert delivery (M1). All optional. With NONE set, alerts are still detected
# and shown in the panel — they just aren't pushed anywhere.
ALERT_EVAL_INTERVAL_S=30
# Storm control (2026-09-28): email an alert once it has lasted ALERT_NOTIFY_AFTER_S (offline:
# once silent OFFLINE_AFTER_S + ALERT_OFFLINE_CONFIRM_S), close it once clear ALERT_CLEAR_AFTER_S,
# email the same alert on the same bridge at most once per ALERT_REPEAT_S, and send more than
# ALERT_DIGEST_OVER messages from one check as one digest.
ALERT_NOTIFY_AFTER_S=60
ALERT_OFFLINE_CONFIRM_S=30
ALERT_CLEAR_AFTER_S=60
ALERT_REPEAT_S=900
ALERT_DIGEST_OVER=3
# Webhook: any URL that accepts a JSON POST (Slack/Discord incoming webhook, n8n, etc.)
ALERT_WEBHOOK_URL=
# Email (all four needed for email to activate):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
