# Copy to .env (or export) before running. NEVER commit real secrets.
DATABASE_URL=postgresql+psycopg://bridge:bridge@localhost/bridge
# Comma-separated bootstrap tokens accepted at device enrollment. Rotate regularly.
BOOTSTRAP_TOKENS=change-me-bootstrap-1,change-me-bootstrap-2
# Admin API key the panel uses to call /admin/*.
ADMIN_API_KEY=change-me-admin-key
OFFLINE_AFTER_S=60
TEMP_ALERT_C=75

# ── Alert delivery (M1). All optional. With NONE set, alerts are still detected
# and shown in the panel — they just aren't pushed anywhere.
ALERT_EVAL_INTERVAL_S=30
# Webhook: any URL that accepts a JSON POST (Slack/Discord incoming webhook, n8n, etc.)
ALERT_WEBHOOK_URL=
# Email (all four needed for email to activate):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
