# Copy to .env on the host and fill in. Never commit the real one.
FLEET_DOMAIN=fleet.yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=samithreddy72@gmail.com
SMTP_PASSWORD=            # the app password from ~/.netbridge/smtp-app-password
ALERT_EMAIL_FROM=samithreddy72@gmail.com
ALERT_EMAIL_TO=samithreddy72@gmail.com

# Optional Tailscale inventory credential with devices:read only.
# Leave empty to disable mesh-expiry monitoring. Never reuse this for key minting.
TS_DEVICES_READ_TOKEN=

# Required for mesh-only presenter access. Set on the host, never commit secrets.
TS_API_KEY=
TS_TAILNET=
# Set these to the EXACT tag names allowed by your tailnet policy and OAuth client.
# Existing installations may use tag:source instead of tag:nb-source. Do not rename
# live tags to match this template; preserve the configured policy.
TS_SOURCE_TAG=tag:nb-source
TS_BRIDGE_TAG=tag:bridge
TS_KEY_TTL_S=600
# Temporary first-admin credential; clear after the first admin is created.
ADMIN_API_KEY=
# Device enrollment only: configure temporarily for enrollment, then clear.
BOOTSTRAP_TOKENS=
