# Copy to .env on the host and fill in. Never commit the real one.
FLEET_DOMAIN=fleet.yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=samithreddy72@gmail.com
SMTP_PASSWORD=            # the app password from ~/.netbridge/smtp-app-password
ALERT_EMAIL_FROM=samithreddy72@gmail.com
ALERT_EMAIL_TO=samithreddy72@gmail.com

# Optional Tailscale inventory credential with devices:read only.
# Leave empty to disable mesh-expiry monitoring. Never reuse this for key minting.
TS_DEVICES_READ_TOKEN=
