#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  fleet — RepliKam admin CLI (runs on the admin Mac, over the tailnet)
#
#    fleet status                    fleet health at a glance
#    fleet show <name>               one device in detail
#    fleet restart <name|all>        restart media on one/all bridges
#    fleet profile <lan|wan> <name|all>
#    fleet update <name|all>         OTA update from the RepliKam2 repo
#    fleet stop|start <name|all>     stop/start media on a bridge
#    fleet reset-clock <name>        fix crackly return audio (rebuilds gadget)
#    fleet reboot <name>             reboot a bridge
#    fleet diagnose <name>           collect a diagnostics bundle on the bridge
#    fleet set-pin <pin> <name>      lock a bridge with a PIN
#    fleet unlock <pin> <name>       unlock a bridge
#    fleet lock <name|all>           lock (stop until PIN)
#    fleet provision <name> k=v ...  stage a one-time claim payload
#    fleet ssh <name>                shell into a bridge (tailscale)
#    fleet alerts                    all active alerts
#    fleet users                     list personal accounts
#    fleet invite <email> [role]     create user, print one-time invite (default presenter)
#    fleet revoke <email>            delete a user (token dies instantly)
#    fleet audit                     recent actions, who did what
#    fleet uptime <name>             SLA: 7-day bars + incidents + streak
#    fleet bundles <name>            list diagnostics bundles on the control plane
#    fleet bundle <name>             download the newest bundle to ~/Downloads
#
#  Config: ~/.fleetrc  (FLEET_URL=... FLEET_KEY=...) — created on first run
#  from ~/Downloads/fleet-admin-credentials.txt if present.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail
RC=~/.fleetrc
if [ ! -f $RC ] && [ -f ~/Downloads/fleet-admin-credentials.txt ]; then
  {
    echo "FLEET_URL=$(grep -oE 'http://[0-9.]+:8000' ~/Downloads/fleet-admin-credentials.txt | head -1)"
    echo "FLEET_KEY=$(grep ADMIN_API_KEY ~/Downloads/fleet-admin-credentials.txt | cut -d= -f2)"
  } > $RC && chmod 600 $RC
fi
[ -f $RC ] || { echo "❌ no ~/.fleetrc (FLEET_URL=, FLEET_KEY=)"; exit 1; }
. $RC
api(){
  R=$(curl -s -m 10 -H "Authorization: Bearer $FLEET_KEY" "$@")
  [ -n "$R" ] || { echo "❌ fleet-brain unreachable (bridge offline or network blip) — try again shortly" >&2; exit 2; }
  echo "$R"
}

py(){ IN=$(cat); [ -n "$IN" ] || exit 2; printf %s "$IN" | python3 -c "$1"; }

resolve(){ # name/hostname/pairing → device id (or 'all')
  [ "$1" = "all" ] && { echo all; return; }
  api "$FLEET_URL/admin/devices" | NAME="$1" py '
import json,sys,os
q=os.environ["NAME"].lower()
for d in json.load(sys.stdin):
    if q in ((d["name"] or "").lower(), (d["hostname"] or "").lower(), (d["pairing_code"] or "").lower(), d["id"].lower()):
        print(d["id"]); break'
}

cmd_one(){ # id type [args-json]
  A="${3:-}"; [ -n "$A" ] || A="{}"
  api -X POST -H "Content-Type: application/json" -d "{\"type\":\"$2\",\"args\":$A}" \
    "$FLEET_URL/admin/devices/$1/commands" | py 'import json,sys; d=json.load(sys.stdin); print("  queued command #%s (%s)" % (d["id"], d["status"]))'
}
cmd_all(){ # type [args-json]
  A="${2:-}"; [ -n "$A" ] || A="{}"
  api -X POST -H "Content-Type: application/json" -d "{\"type\":\"$1\",\"args\":$A}" \
    "$FLEET_URL/admin/commands/broadcast" | py 'import json,sys
for q in json.load(sys.stdin)["queued"]:
    print("  %s: command #%s" % (q["device"], q["command_id"]))'
}
dispatch(){ # type target [args-json]
  T=$(resolve "$2"); [ -n "$T" ] || { echo "❌ unknown bridge: $2"; exit 1; }
  if [ "$T" = "all" ]; then cmd_all "$1" "${3:-}"; else cmd_one "$T" "$1" "${3:-}"; fi
}

case "${1:-help}" in
  status)
    api "$FLEET_URL/admin/devices" | py '
import json,sys
devs=json.load(sys.stdin)
print("%-24s %-8s %-6s %-9s %-13s %s" % ("BRIDGE","STATE","TEMP","SERVICES","VER","ALERTS"))
for d in devs:
    m=d.get("latest") or {}
    svc=sum(1 for s,x in m.get("services",[]) if x=="active")
    al=",".join(a["kind"] for a in d["alerts"]) or "-"
    name=(d["name"] or d["hostname"] or d["id"])[:23]
    state="UP" if d["online"] else "DOWN"
    print("%-24s %-8s %-6s %-9s %-13s %s" % (name,state,str(m.get("temp","?")),str(svc)+"/5",(d["version"] or "?")[:12],al))' ;;
  show)    T=$(resolve "${2:?fleet show <name>}"); api "$FLEET_URL/admin/devices/$T" | python3 -m json.tool | head -50 ;;
  restart) dispatch restart "${2:?fleet restart <name|all>}" ;;
  reboot)  dispatch reboot  "${2:?fleet reboot <name>}" ;;
  update)  dispatch update  "${2:?fleet update <name|all>}" ;;
  profile) dispatch profile "${3:?fleet profile <lan|wan> <name|all>}" "{\"mode\":\"${2}\"}" ;;
  alerts)  api "$FLEET_URL/admin/alerts" | python3 -m json.tool ;;
  stop)    dispatch stop       "${2:?fleet stop <name|all>}" ;;
  start)   dispatch start      "${2:?fleet start <name|all>}" ;;
  reset-clock) dispatch reset-clock "${2:?fleet reset-clock <name>}" ;;
  diagnose) dispatch diagnose  "${2:?fleet diagnose <name>}" ;;
  set-pin) dispatch set-pin    "${3:?fleet set-pin <pin> <name>}" "{\"pin\":\"${2}\"}" ;;
  unlock)  dispatch unlock     "${3:?fleet unlock <pin> <name>}" "{\"pin\":\"${2}\"}" ;;
  lock)    dispatch lock       "${2:?fleet lock <name|all>}" ;;
  provision)  # attach a one-time payload at claim; args after name become key=val pairs
    NAME="${2:?fleet provision <name> key=val ...}"; T=$(resolve "$NAME"); shift 2
    [ -n "$T" ] || { echo "❌ unknown bridge: $NAME"; exit 1; }
    # preserve the device's existing name (claim requires a name field)
    CUR=$(api "$FLEET_URL/admin/devices/$T" | py 'import json,sys; d=json.load(sys.stdin); print(d.get("name") or d.get("hostname") or d["id"])')
    PAYLOAD=$(python3 -c "import json,sys; print(json.dumps(dict(a.split('=',1) for a in sys.argv[1:])))" "$@")
    api -X POST -H "Content-Type: application/json" -d "{\"name\":\"$CUR\",\"provision\":$PAYLOAD}" \
      "$FLEET_URL/admin/devices/$T/claim" >/dev/null && echo "  ✓ provision staged (name preserved: $CUR)" ;;
  users)
    api "$FLEET_URL/admin/users" | py '
import json,sys
us=json.load(sys.stdin)
if not us: print("  no personal accounts yet — fleet invite <email> [role]"); raise SystemExit
print("%-34s %-10s %-8s %s" % ("EMAIL","ROLE","INVITE","LAST SEEN"))
for u in us:
    print("%-34s %-10s %-8s %s" % (u["email"], u["role"],
          "pending" if u["pending_invite"] else "-", (u["last_seen"] or "never")[:16]))' ;;
  invite)
    E="${2:?fleet invite <email> [admin|presenter]}"; R="${3:-presenter}"
    api -X POST -H "Content-Type: application/json" -d "{\"email\":\"$E\",\"role\":\"$R\"}" \
      "$FLEET_URL/admin/users" | py '
import json,sys
d=json.load(sys.stdin)
if "invite" not in d: print("  failed: %s" % d.get("detail", d)); raise SystemExit(1)
print("  %s invited as %s" % (d["email"], d["role"]))
print("  ONE-TIME invite (shown only now — deliver it offline):")
print("    %s" % d["invite"])' ;;
  revoke)
    E="${2:?fleet revoke <email>}"
    USERID=$(api "$FLEET_URL/admin/users" | EMAIL="$E" py '
import json,sys,os
for u in json.load(sys.stdin):
    if u["email"] == os.environ["EMAIL"]: print(u["id"]); break')
    [ -n "$USERID" ] || { echo "❌ no user $E"; exit 1; }
    api -X DELETE "$FLEET_URL/admin/users/$USERID" >/dev/null && echo "  ✓ revoked $E (token dead)" ;;
  audit)
    api "$FLEET_URL/admin/audit" | py '
import json,sys
rows=json.load(sys.stdin)
if not rows: print("  no actions recorded yet"); raise SystemExit
for r in rows[:20]:
    print("  %s  %-28s %-22s %s" % ((r["ts"] or "")[:16], r["who"], r["action"], r.get("target") or ""))' ;;
  uptime)
    T=$(resolve "${2:?fleet uptime <name>}"); [ -n "$T" ] || { echo "❌ unknown bridge: $2"; exit 1; }
    api "$FLEET_URL/admin/devices/$T/uptime" | py '
import json,sys
d=json.load(sys.stdin)
bars=""
for w in reversed(d["windows"]):
    p=w["pct"]
    bars += "█" if p>=99 else ("▅" if p>=50 else ("▂" if p>0 else "·"))
print("  7-day (old→new): %s   last 24h: %.1f%%" % (bars, d["windows"][0]["pct"]))
s=d["streak_s"]; print("  clean streak: %dh %02dm   ticks stored: %d" % (s//3600,(s%3600)//60,d["ticks_7d"]))
for i in d["incidents"][-5:]:
    print("  incident: %s for %dmin%s" % (i["start"][:16], i["seconds"]//60, " (ONGOING)" if i.get("ongoing") else ""))' ;;
  bundles)
    T=$(resolve "${2:?fleet bundles <name>}"); [ -n "$T" ] || { echo "❌ unknown bridge: $2"; exit 1; }
    api "$FLEET_URL/admin/devices/$T/diagnostics" | py '
import json,sys
bs=json.load(sys.stdin)
if not bs: print("  no bundles — queue one with: fleet diagnose <name>"); raise SystemExit
for b in bs: print("  #%-3s %s  %5.1f KB  %s" % (b["id"], b["filename"], b["size"]/1024, (b["created_at"] or "")[:16]))' ;;
  bundle)
    T=$(resolve "${2:?fleet bundle <name>}"); [ -n "$T" ] || { echo "❌ unknown bridge: $2"; exit 1; }
    B=$(api "$FLEET_URL/admin/devices/$T/diagnostics" | py '
import json,sys
bs=json.load(sys.stdin)
print("%s %s" % (bs[0]["id"], bs[0]["filename"]) if bs else "")')
    [ -n "$B" ] || { echo "❌ no bundles — run: fleet diagnose $2 (ready ~40s later)"; exit 1; }
    BID=${B%% *}; BFN=${B##* }
    curl -s -m 30 -H "Authorization: Bearer $FLEET_KEY" -o ~/Downloads/"$BFN" "$FLEET_URL/admin/diagnostics/$BID" \
      && echo "  ✓ ~/Downloads/$BFN ($(stat -f%z ~/Downloads/"$BFN" 2>/dev/null || stat -c%s ~/Downloads/"$BFN") bytes)" ;;
  ssh)
    T="${2:?fleet ssh <name>}"
    IP=$(api "$FLEET_URL/admin/devices" | NAME="$T" py '
import json,sys,os
q=os.environ["NAME"].lower()
for d in json.load(sys.stdin):
    if q in ((d["name"] or "").lower(), (d["hostname"] or "").lower(), (d["pairing_code"] or "").lower()):
        print(d["tailscale_ip"]); break')
    [ -n "$IP" ] || { echo "❌ unknown bridge"; exit 1; }
    exec ssh -i ~/.ssh/pi_bridge pi@"$IP" ;;
  *) sed -n '3,26p' "$0" ;;
esac
